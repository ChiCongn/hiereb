# ── Kafka ──────────────────────────────────────────────────────────────────
# Containers connect via internal PLAINTEXT listener: kafka:29092
# Your host machine connects via: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── Data ───────────────────────────────────────────────────────────────────
DATA_PATH=/data
# Presets:
#   one_house   or one-house   + one_day/five_days/a_week/all
#   five_houses or five-house  + one_day/five_days/a_week/all
#   all_house   or all-house   + one_day/five_days/a_week/all
#   custom      + DATA_FILE or DATA_GLOB; house count is auto-detected by default
# For multi-house one_day/five_days/a_week runs, prepare per-house files at:
#   data/partitioned/<one-day|five-days|a-week>/house-<id>.csv
# Example:
#   python scripts/partition_debs_by_house.py --input data/all-house/one-day.csv \
#     --output-dir data/partitioned/one-day --property 1
DATASET_PRESET=one_house
DATA_WINDOW=one_day

# Used by DATASET_PRESET=custom. DATA_FILE may be one CSV, comma-separated CSVs,
# or a directory containing house-*.csv. DATA_GLOB wins when non-empty.
DATA_FILE=house-1.csv
DATA_GLOB=
AUTO_DETECT_HOUSE_IDS=1
AUTO_DETECT_TIME_WINDOW=0

# Used by DATASET_PRESET=one_house / five_houses.
ONE_HOUSE_ID=0
# Choose five IDs that exist in the prepared partitions.
FIVE_HOUSE_IDS=[0,1,2,10,11]

# Used only when AUTO_DETECT_HOUSE_IDS=0.
HOUSE_IDS=[]
PROPERTY_FILTER=1
WARMUP_START=1377993600
WARMUP_END=1378598399
EVAL_START=1378598400
EVAL_END=1379203199
# Streaming replay keeps this many rows in memory for each selected house file.
STREAM_READ_CHUNK_SIZE=10000

# ── Simulator ──────────────────────────────────────────────────────────────
REPLAY_SPEED=60
# Modes:
#   full_tx = no suppression baseline, transmission stays near 100%
#   uniform = active-budget baseline, delta_p = Delta_H / active plug count
#   hiereb  = apply the adaptive HierEB system
SUPPRESSION_MODE=hiereb
# Timestamp modes:
#   wall_clock = simulated stream appears at current time in Grafana
#   live       = alias of wall_clock
#   stream_epoch = rewrite CSV timestamps to now + source offset, preserving gaps
#   source     = keep original DEBS/CSV event timestamps
STREAM_TIME_MODE=wall_clock

# ── HierEB Algorithm ───────────────────────────────────────────────────────
# EPSILON_H < 1 is a ratio of mean training house load; EPSILON_H >= 1 is Watts.
EPSILON_H=0.05
TAU=300
# Event-time window for budget-active plug membership in uniform mode.
ACTIVE_WINDOW_SECONDS=3600
# Legacy/debug only; baseline uniform mode does not read this fixed threshold.
UNIFORM_DELTA=10.0
RUN_ID=hiereb_live
TRAINING_DAYS=7
PREDICTOR_BIN_SECONDS=300
PREDICTION_CACHE_MAX_SECONDS=1800

# ── TimescaleDB ────────────────────────────────────────────────────────────
# DB_HOST / DB_PORT are for container-to-container connections (always 5432 inside)
# To connect from your HOST machine, use port 5433:
#   psql -h localhost -p 5433 -U hiereb -d hiereb_db
DB_HOST=timescaledb
DB_PORT=5432
DB_PORT_EXTERNAL=5433
DB_USER=hiereb
DB_PASSWORD=hiereb_pass
DB_NAME=hiereb_db
DB_POOL_SIZE=5
DB_WRITE_BATCH_SIZE=100

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Timing ─────────────────────────────────────────────────────────────────
BATCH_INTERVAL_SECONDS=300
FLUSH_DELAY_SECONDS=0.1
