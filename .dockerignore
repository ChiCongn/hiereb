# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.egg

# ── Tests (not needed in production image) ──────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/

# ── Data (NEVER bake DEBS data into image – mount via volume instead) ────────
data/
*.csv
*.parquet

# ── Figures / paper output ───────────────────────────────────────────────────
figures/
results/
*.png
*.pdf

# ── Env files (injected at runtime via docker-compose env_file / environment) 
.env
.env.*
!.env.example

# ── Git ──────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Docker build artefacts ───────────────────────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Notebooks / scratch ──────────────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/
notebooks/
scratch/