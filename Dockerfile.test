# ─────────────────────────────────────────────────────────────────────────────
# HierEB – CI Test Dockerfile  (Dockerfile.test)
#
# Runs the full test suite (85 tests, no Kafka/DB required).
# All tests are pure Python unit tests.
#
# Usage:
#   docker build -f Dockerfile.test -t hiereb:test .
#   docker run --rm hiereb:test
#
# Exit code:
#   0 → all tests passed
#   1 → one or more tests failed
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install runtime + dev extras
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

# Copy full source including tests
COPY config/ config/
COPY src/     src/
COPY tests/   tests/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Dummy values so settings.py doesn't error on import
    KAFKA_BOOTSTRAP_SERVERS=localhost:9092 \
    DB_HOST=localhost \
    DB_PORT=5432 \
    DATA_PATH=/data \
    HOUSE_IDS=[1]

# Run tests on container start
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]